<?xml version="1.0" encoding="UTF-8"?>
<generalAdapterRun xmlns="http://www.wldelft.nl/fews" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.wldelft.nl/fews https://fewsdocs.deltares.nl/schemas/version1.0/generalAdapterRun.xsd">
	<general>
		<piVersion>1.8</piVersion>
		<rootDir>$REGION_HOME$/modules/MIKE</rootDir>
		<workDir>%ROOT_DIR%</workDir>
		<exportDir>%ROOT_DIR%/Assam/piInputTimeSeries</exportDir>
		<exportDataSetDir>%ROOT_DIR%</exportDataSetDir>
		<exportIdMap>IdExportMIKE</exportIdMap> 
		<importDir>%ROOT_DIR%/Assam/piOutputTimeSeries</importDir>
		<importIdMap>IdImportMIKE</importIdMap>
		<dumpFileDir>$GA_DUMPFILEDIR$</dumpFileDir>
		<dumpDir>%ROOT_DIR%/</dumpDir>
		<diagnosticFile>%ROOT_DIR%/log/piDiagnostic.xml</diagnosticFile>
		<missVal>-99</missVal>
		<convertDatum>true</convertDatum>
	</general>
	<activities>
		<startUpActivities>
			<purgeActivity>
				<filter>%ROOT_DIR%/input/*.*</filter>
			</purgeActivity>
			<purgeActivity>
				<filter>%ROOT_DIR%/states/*.*</filter>
			</purgeActivity>
			<purgeActivity>
				<filter>%ROOT_DIR%/log/*.*</filter>
			</purgeActivity>
			<purgeActivity>
				<filter>%ROOT_DIR%/Assam/piOutputTimeSeries/*.*</filter>
			</purgeActivity>
			<purgeActivity>
				<filter>%ROOT_DIR%/Assam/Brahmaputra_Jaxa_Survey_m1d - Result Files/*.*</filter>
			</purgeActivity>
			<purgeActivity>
				<filter>%ROOT_DIR%/Assam/piInputTimeSeries/DA/*.*</filter>
			</purgeActivity>
			<purgeActivity>
				<filter>%ROOT_DIR%/Assam/InputStates/*.*</filter>
			</purgeActivity>
			<purgeActivity>
				<filter>%ROOT_DIR%/Assam/OutputStates/*.*</filter>
			</purgeActivity>
			<purgeActivity>
				<includeSubdirectories>true</includeSubdirectories>
				<filter>%ROOT_DIR%/work/*.*</filter>
			</purgeActivity>
		</startUpActivities>
		<exportActivities>
			<exportStateActivity>
				<moduleInstanceId>run_mike_forecast</moduleInstanceId>
				<stateExportDir>%ROOT_DIR%/Assam/InputStates</stateExportDir>
				<!-- States are stored at T0 of the run that made them (see importStateActivity): use the state of a
				     run 0-2 days before T0. Its file covers that run's -10 to +5 days, which includes this run's start. -->
				<stateSelection>
					<warmState>
						<stateSearchPeriod unit="day" start="-2" end="0" startOverrulable="true" />
					</warmState>
				</stateSelection>
			</exportStateActivity>
			 <exportTimeSeriesActivity> 
				 <exportFile>forcing.xml</exportFile> 
				<timeSeriesSets>
				<timeSeriesSet>
					<moduleInstanceId>Process_model_grids_to_catchments</moduleInstanceId>
					<valueType>scalar</valueType>
					<parameterId>P.model</parameterId>
					<qualifierId>model</qualifierId>
					<locationSetId>MIKEBasins</locationSetId>
					<timeSeriesType>external historical</timeSeriesType>
					<timeStep unit="hour" multiplier="1"/>
					<relativeViewPeriod unit="day" start="-10" end="5"/>
					<readWriteMode>read only</readWriteMode>
				</timeSeriesSet>
				<timeSeriesSet>
					<moduleInstanceId>Process_model_grids_to_catchments</moduleInstanceId>
					<valueType>scalar</valueType>
					<parameterId>T.model</parameterId>
					<qualifierId>model</qualifierId>
					<locationSetId>MIKEBasins</locationSetId>
					<timeSeriesType>external historical</timeSeriesType>
					<timeStep unit="hour" multiplier="1"/>
					<relativeViewPeriod unit="day" start="-10" end="5"/>
					<readWriteMode>read only</readWriteMode>
				</timeSeriesSet>
				<timeSeriesSet>
					<moduleInstanceId>Process_model_grids_to_catchments</moduleInstanceId>
					<valueType>scalar</valueType>
					<parameterId>PET.model</parameterId>
					<qualifierId>model</qualifierId>
					<locationSetId>MIKEBasins</locationSetId>
					<timeSeriesType>external historical</timeSeriesType>
					<timeStep unit="hour" multiplier="1"/>
					<relativeViewPeriod unit="day" start="-10" end="5"/>
					<readWriteMode>read only</readWriteMode>
				</timeSeriesSet>
			</timeSeriesSets>
			</exportTimeSeriesActivity>
			<!-- Observed water levels for the MIKE+ data assimilation (one DFS0 per station is written by the adapter) -->
			<exportTimeSeriesActivity>
				<exportFile>observations.xml</exportFile>
				<timeSeriesSets>
					<timeSeriesSet>
						<moduleInstanceId>Import_Telemetry</moduleInstanceId>
						<valueType>scalar</valueType>
						<parameterId>H.obs</parameterId>
						<locationSetId>MIKE_DA_Stations</locationSetId>
						<timeSeriesType>external historical</timeSeriesType>
						<timeStep unit="hour"/>
						<relativeViewPeriod unit="day" start="-10" end="0"/>
						<readWriteMode>read only</readWriteMode>
					</timeSeriesSet>
				</timeSeriesSets>
			</exportTimeSeriesActivity>
			<!-- River and chainage of the MIKE result points, read by the adapter (step result_points_to_pixml) -->
			<exportLocationAttributesCsvActivity>
				<exportFile>mike_result_points.csv</exportFile>
				<locationSetId>MIKE_ResultPoints</locationSetId>
				<locationIdColumn columnName="location_id"/>
				<attributeColumn columnName="river" attributeId="River"/>
				<attributeColumn columnName="chainage" attributeId="Chainage"/>
			</exportLocationAttributesCsvActivity>
			<!-- Run file: its time0 is used as the time of forecast of the data assimilation -->
			<exportRunFileActivity>
				<exportFile>%ROOT_DIR%/Assam/piInputTimeSeries/run_info.xml</exportFile>
			</exportRunFileActivity>
		</exportActivities>
		<executeActivities>
		<executeActivity>
				<description>Convert pixml to dfs0</description>
				<command>
					<executable>$REGION_HOME$/Modules/python/BinPython/python.exe</executable>
				</command>
				<arguments>
					<argument>-m</argument>
					<argument>fews_mike_adapter</argument>
					<argument>--forecast</argument>
				</arguments>
				<timeOut>1200000</timeOut>
				<ignoreDiagnostics>true</ignoreDiagnostics>
			</executeActivity>
		</executeActivities>
		<importActivities>
			<!-- The adapter writes the states as <name>_<T0 yyyyMMdd_HHmmss>.res1d, so FEWS stores them at T0
			     (not at the end of the run). Each file is the whole result of this run; on the next warm start
			     MIKE takes the time step at that run's simulation start from it. -->
			<importStateActivity>
				<stateImportDir>%ROOT_DIR%/Assam/OutputStates</stateImportDir>
				<stateFileDateTimePattern>'nam_state_'yyyyMMdd_HHmmss'.res1d'</stateFileDateTimePattern>
				<relativeExportFile>nam_state.res1d</relativeExportFile>
				<stateFileDateTimePattern>'state_1d_'yyyyMMdd_HHmmss'.res1d'</stateFileDateTimePattern>
				<relativeExportFile>state_1d.res1d</relativeExportFile>
				<expiryTime unit="day" multiplier="5"/>
			</importStateActivity>
			<importTimeSeriesActivity>
				<importFile>simulation_nam.xml</importFile>
				<timeSeriesSets>
					<timeSeriesSet>
						<moduleInstanceId>run_mike_forecast</moduleInstanceId>
						<valueType>scalar</valueType>
						<parameterId>Q.sim</parameterId>
						<locationSetId>MIKEBasins</locationSetId>
						<timeSeriesType>simulated forecasting</timeSeriesType>
						<timeStep unit="nonequidistant"/>
						<readWriteMode>add originals</readWriteMode>
					</timeSeriesSet>
				</timeSeriesSets>
			</importTimeSeriesActivity>
			<!-- MIKE results at the result points (locationSet MIKE_ResultPoints) -->
			<importTimeSeriesActivity>
				<importFile>simulation_result_points.xml</importFile>
				<timeSeriesSets>
					<timeSeriesSet>
						<moduleInstanceId>run_mike_forecast</moduleInstanceId>
						<valueType>scalar</valueType>
						<parameterId>H.sim</parameterId>
						<locationSetId>MIKE_ResultPoints</locationSetId>
						<timeSeriesType>simulated forecasting</timeSeriesType>
						<timeStep unit="hour" multiplier="1"/>
						<readWriteMode>add originals</readWriteMode>
					</timeSeriesSet>
					<timeSeriesSet>
						<moduleInstanceId>run_mike_forecast</moduleInstanceId>
						<valueType>scalar</valueType>
						<parameterId>Q.sim</parameterId>
						<locationSetId>MIKE_ResultPoints</locationSetId>
						<timeSeriesType>simulated forecasting</timeSeriesType>
						<timeStep unit="hour" multiplier="1"/>
						<readWriteMode>add originals</readWriteMode>
					</timeSeriesSet>
				</timeSeriesSets>
			</importTimeSeriesActivity>
		</importActivities>
	</activities>
</generalAdapterRun>
