<?xml version="1.0" encoding="UTF-8"?>
<generalAdapterRun xmlns="http://www.wldelft.nl/fews" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.wldelft.nl/fews https://fewsdocs.deltares.nl/schemas/version1.0/generalAdapterRun.xsd">
	<general>
		<piVersion>1.8</piVersion>
		<rootDir>$REGION_HOME$/modules/MIKE</rootDir>
		<workDir>%ROOT_DIR%</workDir>
		<exportDir>%ROOT_DIR%/Assam/piInputTimeSeries</exportDir>
		<exportDataSetDir>%ROOT_DIR%</exportDataSetDir>
		<exportIdMap>IdExportMIKE</exportIdMap> 
		<importDir>%ROOT_DIR%/Assam/piOutputTimeSeries</importDir>
		<importIdMap>IdImportMIKE</importIdMap>
		<dumpFileDir>$GA_DUMPFILEDIR$</dumpFileDir>
		<dumpDir>%ROOT_DIR%/</dumpDir>
		<diagnosticFile>%ROOT_DIR%/log/piDiagnostic.xml</diagnosticFile>
		<missVal>-99</missVal>
		<convertDatum>true</convertDatum>
	</general>
	<activities>
		<startUpActivities>
			<purgeActivity>
				<filter>%ROOT_DIR%/input/*.*</filter>
			</purgeActivity>
			<purgeActivity>
				<filter>%ROOT_DIR%/states/*.*</filter>
			</purgeActivity>
			<purgeActivity>
				<filter>%ROOT_DIR%/log/*.*</filter>
			</purgeActivity>
			<purgeActivity>
				<filter>%ROOT_DIR%/Assam/piOutputTimeSeries/*.*</filter>
			</purgeActivity>
			<purgeActivity>
				<filter>%ROOT_DIR%/Assam/Test FF_2025_2025_2025_2025_m1d - Result Files/*.*</filter>
			</purgeActivity>
			<purgeActivity>
				<filter>%ROOT_DIR%/Assam/InputStates/*.*</filter>
			</purgeActivity>
			<purgeActivity>
				<filter>%ROOT_DIR%/Assam/OutputStates/*.*</filter>
			</purgeActivity>
			<purgeActivity>
				<includeSubdirectories>true</includeSubdirectories>
				<filter>%ROOT_DIR%/work/*.*</filter>
			</purgeActivity>
		</startUpActivities>
		<exportActivities>
			<exportStateActivity>
				<moduleInstanceId>run_mike_forecast</moduleInstanceId>
				<stateExportDir>%ROOT_DIR%/Assam/InputStates</stateExportDir>
				<stateSelection>
					<warmState>
						<stateSearchPeriod unit="day" start="3" end="5" startOverrulable="true" />
					</warmState>
				</stateSelection>
			</exportStateActivity>
			 <exportTimeSeriesActivity> 
				 <exportFile>forcing.xml</exportFile> 
				<timeSeriesSets>
				<timeSeriesSet>
					<moduleInstanceId>Process_model_grids_to_catchments</moduleInstanceId>
					<valueType>scalar</valueType>
					<parameterId>P.obs</parameterId>
					<qualifierId>model</qualifierId>
					<locationSetId>MIKEBasins</locationSetId>
					<timeSeriesType>external forecasting</timeSeriesType>
					<timeStep unit="hour" multiplier="1"/>
					<relativeViewPeriod unit="day" start="-10" end="5"/>
					<readWriteMode>read complete forecast</readWriteMode>
				</timeSeriesSet>
				<timeSeriesSet>
					<moduleInstanceId>Process_model_grids_to_catchments</moduleInstanceId>
					<valueType>scalar</valueType>
					<parameterId>T.forecast</parameterId>
					<qualifierId>model</qualifierId>
					<locationSetId>MIKEBasins</locationSetId>
					<timeSeriesType>external forecasting</timeSeriesType>
					<timeStep unit="hour" multiplier="1"/>
					<relativeViewPeriod unit="day" start="-10" end="5"/>
					<readWriteMode>read complete forecast</readWriteMode>
				</timeSeriesSet>
				<timeSeriesSet>
					<moduleInstanceId>Process_model_grids_to_catchments</moduleInstanceId>
					<valueType>scalar</valueType>
					<parameterId>PET.forecast</parameterId>
					<qualifierId>model</qualifierId>
					<locationSetId>MIKEBasins</locationSetId>
					<timeSeriesType>external forecasting</timeSeriesType>
					<timeStep unit="hour" multiplier="1"/>
					<relativeViewPeriod unit="day" start="-10" end="5"/>
					<readWriteMode>read complete forecast</readWriteMode>
				</timeSeriesSet>
			</timeSeriesSets>
			</exportTimeSeriesActivity>
		</exportActivities>
		<executeActivities>
		<executeActivity>
				<description>MIKE+ forecast: PI-XML to DFS0, run MIKE+, results to PI-XML</description>
				<command>
					<executable>$MIKE_ADAPTER_EXE$</executable>
				</command>
				<arguments>
					<argument>--forecast</argument>
				</arguments>
				<timeOut>1200000</timeOut>
				<ignoreDiagnostics>true</ignoreDiagnostics>
			</executeActivity>
		</executeActivities>
		<importActivities>
			<importStateActivity>
			<stateImportDir>%ROOT_DIR%/Assam/OutputStates</stateImportDir>
				<stateFile>
					<importFile>nam_state.res1d</importFile>
					<relativeExportFile>nam_state.res1d</relativeExportFile>
				</stateFile>
				<stateFile>
					<importFile>state_1d.res1d</importFile>
					<relativeExportFile>state_1d.res1d</relativeExportFile>
				</stateFile>
				<expiryTime unit="day" multiplier="5"/>
			</importStateActivity>
			<importTimeSeriesActivity>
				<importFile>simulation_nam.xml</importFile>
				<timeSeriesSets>
					<timeSeriesSet>
						<moduleInstanceId>run_mike_forecast</moduleInstanceId>
						<valueType>scalar</valueType>
						<parameterId>Q.sim</parameterId>
						<locationSetId>MIKEBasins</locationSetId>
						<timeSeriesType>simulated forecasting</timeSeriesType>
						<timeStep unit="nonequidistant"/>
						<readWriteMode>add originals</readWriteMode>
					</timeSeriesSet>
				</timeSeriesSets>
			</importTimeSeriesActivity>
			<importTimeSeriesActivity>
				<importFile>simulation_mike11.xml</importFile>
				<timeSeriesSets>
					<timeSeriesSet>
						<moduleInstanceId>run_mike_forecast</moduleInstanceId>
						<valueType>scalar</valueType>
						<parameterId>H.sim</parameterId>
						<locationSetId>MIKENodes</locationSetId>
						<timeSeriesType>simulated forecasting</timeSeriesType>
						<timeStep unit="minute" multiplier="1"/>
						<readWriteMode>add originals</readWriteMode>
					</timeSeriesSet>
				</timeSeriesSets>
			</importTimeSeriesActivity>
		</importActivities>
	</activities>
</generalAdapterRun>
